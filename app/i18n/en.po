msgid "+1 quadrado de vida"
msgstr "+1 health block"

msgid "Arpão de mão"
msgstr "Hand Harpoon"

msgid "Segure o tiro para carregar um arpão que atravessa escudos e inimigos"
msgstr "Hold fire to charge a harpoon that pierces shields and enemies"

msgid "Couraça do Regulador"
msgstr "Regulator's Plate"

msgid "Uma placa de latão absorve um golpe e se recarrega com o tempo"
msgstr "A brass plate absorbs one hit and recharges over time"

msgid "Botas de Pressão"
msgstr "Pressure Boots"

msgid "No ar, aperte [roll] para dar um impulso na direção em que está olhando"
msgstr "In the air, press [roll] to dash in the direction you're facing"

msgid "Mover para a esquerda"
msgstr "Move left"

msgid "Mover para a direita"
msgstr "Move right"

msgid "Cima / encostar"
msgstr "Up / take cover"

msgid "Agachar"
msgstr "Crouch"

msgid "Pular"
msgstr "Jump"

msgid "Atirar"
msgstr "Shoot"

msgid "Rolar"
msgstr "Roll"

msgid "Trotar / correr"
msgstr "Jog / run"

msgid "Interagir"
msgstr "Interact"

msgid "Usar ferramenta"
msgstr "Use tool"

msgid "Trocar ferramenta"
msgstr "Swap tool"

msgid "Pausa"
msgstr "Pause"

msgid "Normal"
msgstr "Normal"

msgid "Intenso"
msgstr "Intense"

msgid "Insano"
msgstr "Insane"


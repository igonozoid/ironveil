msgid "Ato 1 — As Caldeiras"
msgstr "Act 1 — The Boilers"

msgid "As Caldeiras"
msgstr "The Boilers"

msgid "Ato 2 — O Mercado Suspenso"
msgstr "Act 2 — The Hanging Market"

msgid "O Mercado Suspenso"
msgstr "The Hanging Market"

msgid "Ato 3 — A Torre do Diretório"
msgstr "Act 3 — The Directorate Tower"

msgid "A Torre do Diretório"
msgstr "The Directorate Tower"

msgid "Ato 4 — As Fundições Profundas"
msgstr "Act 4 — The Deep Foundries"

msgid "As Fundições Profundas"
msgstr "The Deep Foundries"

msgid "Ato 5 — O Véu de Ferro"
msgstr "Act 5 — The Iron Veil"

msgid "O Véu de Ferro"
msgstr "The Iron Veil"

msgid "Caldeira Norte"
msgstr "North Boiler"

msgid "Sala das Bombas"
msgstr "Pump Room"

msgid "Poço do Guindaste"
msgstr "Crane Shaft"

msgid "Docas de Carga"
msgstr "Cargo Docks"

msgid "Bazar das Correntes"
msgstr "Chain Bazaar"

msgid "Telhados do Diretório"
msgstr "Directorate Rooftops"

msgid "Átrio de Bronze"
msgstr "Bronze Atrium"

msgid "Engrenagem Mestra"
msgstr "Master Gear"

msgid "Gabinete do Diretor"
msgstr "Director's Office"

msgid "Poço de Escória"
msgstr "Slag Shaft"

msgid "Cadinhos"
msgstr "Crucibles"

msgid "Coração da Montanha"
msgstr "Heart of the Mountain"

msgid "Passarelas do Véu"
msgstr "Veil Catwalks"

msgid "Doca da Frota"
msgstr "Fleet Dock"

msgid "A Coroa"
msgstr "The Crown"

msgid "Carga de vapor"
msgstr "Steam charge"

msgid "Selante"
msgstr "Sealant"

